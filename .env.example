# Neon PostgreSQL. Copiar este archivo como .env y completar los valores.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require

# Seguridad: generar valores aleatorios y privados. Nunca reutilizar los ejemplos.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
ADMIN_EMAIL=admin@rinovastays.com
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_DE_AL_MENOS_12_CARACTERES

# Opcional. Sólo habilitar si la URL de Ollama es accesible desde el servidor remoto.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3:latest
OLLAMA_ENABLED=false
